// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// ENUMS
// ==========================

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RentalStatus {
  PLACED
  CONFIRMED
  PAID
  PICKED_UP
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
}

enum PaymentMethod {
  CARD
  MOBILE_BANKING
  BANK
}

model User {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique
  password String
  role     UserRole   @default(CUSTOMER)
  phone    String?
  address  String?
  status   UserStatus @default(ACTIVE)

  gearItems    GearItem[]
  rentalOrders RentalOrder[]
  payments     Payment[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ==========================
// CATEGORY
// ==========================

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  gearItems GearItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// ==========================
// GEAR ITEM
// ==========================

model GearItem {
  id             String  @id @default(uuid())
  name           String
  description    String
  brand          String
  pricePerDay    Decimal @db.Decimal(10, 2)
  stock          Int
  availableStock Int
  image          String?
  isAvailable    Boolean @default(true)

  providerId String
  provider   User   @relation(fields: [providerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  rentalItems RentalItem[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([categoryId])
  @@index([brand])
  @@map("gear_items")
}

// ==========================
// RENTAL ORDER
// ==========================

model RentalOrder {
  id String @id @default(uuid())

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  startDate DateTime
  endDate   DateTime

  totalAmount Decimal @db.Decimal(10, 2)

  status        RentalStatus  @default(PLACED)
  paymentStatus PaymentStatus @default(PENDING)

  items    RentalItem[]
  payments Payment[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("rental_orders")
}

// ==========================
// RENTAL ITEM
// ==========================

model RentalItem {
  id String @id @default(uuid())

  rentalOrderId String
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)

  gearItemId String
  gearItem   GearItem @relation(fields: [gearItemId], references: [id])

  quantity Int

  pricePerDay Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)

  @@index([rentalOrderId])
  @@index([gearItemId])
  @@map("rental_items")
}

// ==========================
// PAYMENT
// ==========================

model Payment {
  id String @id @default(uuid())

  transactionId String @unique

  rentalOrderId String
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  method   PaymentMethod
  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalOrderId])
  @@index([customerId])
  @@map("payments")
}

// ==========================
// REVIEW
// ==========================

model Review {
  id String @id @default(uuid())

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  gearItemId String
  gearItem   GearItem @relation(fields: [gearItemId], references: [id])

  rentalOrderId String
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([gearItemId])
  @@index([rentalOrderId])
  @@map("reviews")
}
